# Copy to deploy/.env on the server. Never commit the real file.
API_DOMAIN=api.velenzay.com
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24
JWT_SECRET=generate-with-openssl-rand-hex-32
CORS_ORIGINS=["https://velenzay.com","https://www.velenzay.com"]
WEB_WORKERS=2

# Cloudflare R2 (product images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=velenzay-images
R2_PUBLIC_BASE_URL=https://img.velenzay.com

# First admin account (used by seed.py)
SEED_ADMIN_EMAIL=you@yourdomain.pk
SEED_ADMIN_PASSWORD=choose-a-long-password

# Verification codes. "console" writes codes to the API log (development only).
# EMAIL_PROVIDER: console | resend    SMS_PROVIDER: console | off | http | twilio
# SMS_PROVIDER=off is free: customers verify by email only (you still confirm COD orders by phone).
# SMS_PROVIDER=http works with any Pakistani bulk-SMS gateway: paste its send link, putting {to} where the
# number goes (sent as 923XXXXXXXXX) and {text} where the message goes, e.g.
#   SMS_HTTP_URL=https://gateway.example.pk/api/send?key=YOUR_KEY&to={to}&message={text}
EMAIL_PROVIDER=console
EMAIL_FROM=Velenzay <no-reply@velenzay.com>
RESEND_API_KEY=
SMS_PROVIDER=off
SMS_HTTP_URL=
SMS_HTTP_METHOD=GET
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# "Continue with Google": the same client id the storefront uses (the secret stays with the storefront)
GOOGLE_CLIENT_ID=

# "Continue with Facebook": app id + secret from developers.facebook.com. SITE_URL must be the storefront address.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
SITE_URL=https://velenzay.com

# Contact-form messages are emailed here (they're also always in Admin → Messages)
STORE_EMAIL=
