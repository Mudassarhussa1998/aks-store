# Copy to deploy/.env on the server. Never commit the real file.
API_DOMAIN=api.aks.pk
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-24
JWT_SECRET=generate-with-openssl-rand-hex-32
CORS_ORIGINS=["https://aks.pk","https://www.aks.pk"]
WEB_WORKERS=2

# Cloudflare R2 (product images)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aks-images
R2_PUBLIC_BASE_URL=https://img.aks.pk

# First admin account (used by seed.py)
SEED_ADMIN_EMAIL=you@yourdomain.pk
SEED_ADMIN_PASSWORD=choose-a-long-password

# Verification codes. "console" writes codes to the API log (development only).
# EMAIL_PROVIDER: console | resend    SMS_PROVIDER: console | twilio
EMAIL_PROVIDER=console
EMAIL_FROM=Aks.pk <no-reply@aks.pk>
RESEND_API_KEY=
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
