# Copy to .env and fill in. Never commit .env.
ENV=development
DATABASE_URL=postgresql+asyncpg://localhost/aks
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=generate-with-openssl-rand-hex-32
CORS_ORIGINS=["http://localhost:3000"]

# Cloudflare R2 for product images (leave blank in development to store under ./media)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
MEDIA_BASE_URL=http://localhost:8000/media

# Used only by seed.py to create the first admin account
SEED_ADMIN_EMAIL=admin@rawaj.pk
SEED_ADMIN_PASSWORD=change-this-admin-password

# Verification codes. "console" writes codes to the API log (development only).
# EMAIL_PROVIDER: console | resend    SMS_PROVIDER: console | twilio
EMAIL_PROVIDER=console
EMAIL_FROM=Rawaj.pk <no-reply@rawaj.pk>
RESEND_API_KEY=
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# "Continue with Google": the same client id the storefront uses (the secret stays with the storefront)
GOOGLE_CLIENT_ID=

# "Continue with Facebook": app id + secret from developers.facebook.com. SITE_URL must be the storefront address.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
SITE_URL=http://localhost:3000

# Contact-form messages are emailed here (they're also always in Admin → Messages)
STORE_EMAIL=
