# Backend API base URL (server-side only)
API_URL=http://localhost:8000/api/v1
SITE_URL=http://localhost:3000

# "Continue with Google" (until set, the button shows "coming soon"). From Google Cloud Console → Credentials → OAuth client (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# "Continue with Facebook" (until set, the button shows "coming soon"). Only the app id; the secret goes in the API's env.
FACEBOOK_APP_ID=

# Google Search Console → Ownership verification → HTML tag (just the content="…" value)
GOOGLE_SITE_VERIFICATION=
